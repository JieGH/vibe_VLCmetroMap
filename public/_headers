# Cloudflare Workers static assets read this file (Netlify uses netlify.toml). A deploy replaces the hashed files
# in /assets, so the page that names them must never be served stale (#132).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
