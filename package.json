{
  "name": "vibe-vlc-metro-map",
  "version": "0.0.0",
  "private": true,
  "description": "Live map of every train on the Valencia metro, positioned from real-time arrival predictions walked back along the actual rail geometry. Offline vector basemap, web + native iOS.",
  "author": "Jie",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/JieGH/vibe_VLCmetroMap.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "prebuild": "node scripts/sync_maplibre_worker.cjs && node scripts/prepare_basemap.cjs",
    "build": "vite build",
    "postbuild": "[ \"$CI\" = true ] || npx cap sync ios",
    "test": "vitest run",
    "test:integrity": "node scripts/sync_maplibre_worker.cjs && vitest run src/utils/mapIntegrity.test.js",
    "notify:deploy": "node scripts/notify_telegram.cjs deploy",
    "notify:incident": "node scripts/notify_telegram.cjs incident",
    "fetch:gtfs": "node scripts/fetch_gtfs.cjs",
    "build:data": "npm run build:stations && npm run build:segments",
    "build:geometry": "node scripts/simplify_line_geometry.cjs",
    "build:timetable": "node scripts/build_line3_timetable.cjs",
    "build:segments": "node scripts/build_segment_times.cjs",
    "build:stations": "node scripts/generate_gtfs_geojson.cjs",
    "fetch:line4": "node --no-warnings scripts/fetch_line4_overpass.cjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "serve": "node server/index.js",
    "build:line4": "node scripts/convert_line4_osm_to_geojson.cjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "fetch:basemap": "node scripts/fetch_basemap.cjs",
    "sweep": "node scripts/sweep_coverage.cjs",
    "measure": "node scripts/measure_latency.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/ios": "^8.5.3",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "pmtiles": "^4.5.0",
    "protomaps-themes-base": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
