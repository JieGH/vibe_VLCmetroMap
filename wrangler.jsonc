{
  // Cloudflare Workers deployment of the public website. See docs/hosting-cloudflare.md.
  "name": "vibe-vlcmetromap",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat_populate_process_env lets the shared proxy read METRO_SOURCE from `vars`.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // FGV answers Cloudflare's Madrid edge directly: FGV only, no third-party relay.
  "vars": {
    "METRO_SOURCE": "fgv",
    "TELEGRAM_BOT_TOKEN": "8763009106:AAGwvWk6o8T0FXRVMZZuR6ANFopQ_wMB_mU",
    "TELEGRAM_CHAT_ID": "5007040501"
  },
  // `wrangler preview` (non-production branch builds) wants its own values rather than inheriting production's.
  "previews": {
    "vars": {
      "METRO_SOURCE": "fgv",
      "TELEGRAM_BOT_TOKEN": "8763009106:AAGwvWk6o8T0FXRVMZZuR6ANFopQ_wMB_mU",
      "TELEGRAM_CHAT_ID": "5007040501"
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
